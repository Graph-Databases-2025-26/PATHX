# --- IBM watsonx ---
WATSONX_API_KEY=YOUR_WATSONX_API_KEY_HERE
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=YOUR_WATSONX_PROJECT_ID_HERE
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
WATSONX_TEMPERATURE=0.2
WATSONX_MAX_NEW_TOKENS=4096

# --- Google Gemini ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_NAME="gemini-2.5-flash"

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://YOUR_AZURE_RESOURCE_NAME.cognitiveservices.azure.com/openai/deployments/YOUR_DEPLOYMENT_NAME/chat/completions?api-version=2025-01-01-preview
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY_HERE
AZURE_OPENAI_API_VERSION=2024-10-21 
AZURE_OPENAI_DEPLOYMENT=gpt-4o

